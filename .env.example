# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Backend API Configuration
BACKEND_API_URL=http://localhost:8000
ENVIRONMENT=development

# Video Ingestion Constraints
MAX_VIDEO_DURATION_SECONDS=360.0

# Modal Serverless Compute Configuration (Future background worker)
MODAL_TOKEN_ID=your-modal-token-id-placeholder
MODAL_TOKEN_SECRET=your-modal-token-secret-placeholder
MODAL_ENVIRONMENT=main

# Worker Callback Secret (Internal serverless worker authentication)
WORKER_CALLBACK_SECRET=your-worker-callback-secret-placeholder
